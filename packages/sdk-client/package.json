{
  "name": "@ddp/sdk-client",
  "version": "0.0.1",
  "private": true,
  "description": "Internal DDP client SDK — typed wrappers for Appwrite, Colyseus, LiveKit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ddp/shared-types": "workspace:*"
  }
}
