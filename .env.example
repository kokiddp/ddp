# ============================================================================
# DDP — Unified Environment Configuration
# ============================================================================
# Copy to .env at the repository root:  cp .env.example .env
# This single file configures ALL services (Docker infra + application).
#
# Local dev:   ./setup.sh           (needs Node.js + pnpm)
# Docker-only: ./setup.sh --docker  (needs only Docker — no Node.js)
# ============================================================================

# ── General ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Domain & TLS ────────────────────────────────────────────────────────────
# For production: set to your domain (e.g. ddp.example.com)
# For local dev: leave as localhost
_APP_DOMAIN=localhost

# Let's Encrypt email — set this to enable automatic TLS certificates.
# Leave empty for local development (no TLS).
ACME_EMAIL=

# ── Appwrite ────────────────────────────────────────────────────────────────
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=ddp
# Create this key in the Appwrite Console after first-time setup:
#   http://localhost/console → Project ddp → Settings → API Keys → Create
APPWRITE_API_KEY=

# Docker-level Appwrite config
_APP_ENV=development
_APP_OPENSSL_KEY_V1=ddp-dev-openssl-key-change-in-prod
_APP_DB_PASS=password
MYSQL_ROOT_PASSWORD=rootpassword
_APP_OPTIONS_FORCE_HTTPS=disabled

# ── LiveKit ─────────────────────────────────────────────────────────────────
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# ── Ports ───────────────────────────────────────────────────────────────────
APPWRITE_PORT=80
APPWRITE_SSL_PORT=443
LIVEKIT_PORT=7880
COLYSEUS_PORT=2567
INTEGRATION_API_PORT=3100
WEB_PORT=5173

# ── Web Client (Vite — baked in at build time) ──────────────────────────────
# Local dev: use localhost URLs with ports
# Production (--docker): use your domain with Traefik path prefixes, e.g.:
#   VITE_APPWRITE_ENDPOINT=https://ddp.example.com/v1
#   VITE_COLYSEUS_URL=wss://ddp.example.com/ws/colyseus
#   VITE_INTEGRATION_API_URL=https://ddp.example.com/api
#   VITE_LIVEKIT_URL=wss://ddp.example.com:7880
VITE_APPWRITE_ENDPOINT=http://localhost/v1
VITE_APPWRITE_PROJECT_ID=ddp
VITE_APPWRITE_AVATAR_BUCKET_ID=
VITE_COLYSEUS_URL=ws://localhost:2567
VITE_INTEGRATION_API_URL=http://localhost:3100
VITE_LIVEKIT_URL=ws://localhost:7880

# ── Integration API ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
LOG_LEVEL=info
